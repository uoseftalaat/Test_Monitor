# Firebase Web App Configuration for TestMonitor
# Obtain these values from your Firebase Console:
# Project Settings > General > Your apps > Web app (create one if not already created)
# Console: https://console.firebase.google.com/u/1/project/test-monitor-46836/overview

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=test-monitor-46836.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=test-monitor-46836
VITE_FIREBASE_STORAGE_BUCKET=test-monitor-46836.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
